# Ms Tanya — copy this file to .env and fill in. NEVER share or commit .env.

# ---- AI provider (one key is enough). anthropic | openai | google | mock (no key, rule-based)
PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# optional: a second provider used when the first fails
FALLBACK_PROVIDER=
# optional: a different provider for the morning compliance audit (second opinion)
AUDIT_PROVIDER=
# optional: meaning search for knowledge (RAG vectors). openai | google  (Anthropic has no embeddings)
EMBEDDING_PROVIDER=openai

# ---- run mode. dev = file memory + dev console (your PC). server = Redis + streams + workers + MySQL
RUN_MODE=server
HOST=127.0.0.1
PORT=8000
DEV_CONSOLE=0
USE_LANGGRAPH=1

# ---- server mode only
REDIS_URL=redis://localhost:6379/0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
# Who gets Tanya (dashboard → AI tab): tg_level.app_settings + tg_level.tanya_ai_phones in TG Lite's
# database. Set these when that database is on another server (read-only user, SELECT on those 2 tables).
# Empty = use the MYSQL_* values above with database tg_level.
ACCESS_DB_HOST=
ACCESS_DB_PORT=3306
ACCESS_DB_USER=
ACCESS_DB_PASSWORD=
ACCESS_DB_NAME=tg_level

# ---- CRM (CODER D fills from inputs A1-A3, A8). console = no CRM (dev console)
CRM_MODE=console
CRM_API_URL=
CRM_API_TOKEN=
CRM_WEBHOOK_SECRET=
TANYA_AGENT_ID=
CRM_HUMAN_DEPARTMENT_ID=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tanya_kb_openai
KNOWLEDGE_BACKEND=qdrant

# ---- voice agent (ElevenLabs webhook tool -> POST /kb/search). Long random string; the same
# value goes in the tool's X-Tool-Secret header in the ElevenLabs dashboard. Empty = endpoint off.
KB_TOOL_SECRET=sample-test-bot-for-agent
# ---- voice calls from the PWA support page (ElevenLabs post-call webhook -> POST /voice/post-call)
# Shown by ElevenLabs when you create the post-call webhook (HMAC secret).
ELEVENLABS_WEBHOOK_SECRET=
# Tanya's agent id (agent_...): webhooks from other agents are ignored.
ELEVENLABS_AGENT_ID=
# SAME value as TANYA_VOICE_CTX_SECRET in pwa-node-backend/.env
TANYA_VOICE_CTX_SECRET=
# Caller brief for voice calls (POST /voice/context, called by pwa-node-backend). SAME value as
# TANYA_CONTEXT_SECRET in pwa-node-backend/.env. Empty = endpoint off.
TANYA_CONTEXT_SECRET=
# App events (POST /events/app, e.g. app_open), sent by TG Lite's backend in the X-App-Secret header.
# Long random string (openssl rand -hex 32), same value on both sides. Empty = endpoint off.
APP_EVENTS_SECRET=

# Who Tanya may answer (dashboard AI tab), served by the PWA box. Unset = read MySQL directly.
ACCESS_URL=https://beta.tglevels.in/api/internal/tanya-access
