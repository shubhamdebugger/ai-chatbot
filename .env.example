# Ms Tanya — copy this file to .env and fill in. NEVER share or commit .env.

# ---- AI provider (one key is enough). anthropic | openai | google | mock (no key, rule-based)
PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# optional: a second provider used when the first fails
FALLBACK_PROVIDER=
# optional: a different provider for the morning compliance audit (second opinion)
AUDIT_PROVIDER=
# optional: meaning search for knowledge (RAG vectors). openai | google  (Anthropic has no embeddings)
EMBEDDING_PROVIDER=openai

# ---- run mode. dev = file memory + dev console (your PC). server = Redis + streams + workers + MySQL
RUN_MODE=server
HOST=127.0.0.1
PORT=8000
DEV_CONSOLE=0
USE_LANGGRAPH=1

# ---- server mode only
REDIS_URL=redis://localhost:6379/0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# ---- CRM (CODER D fills from inputs A1-A3, A8). console = no CRM (dev console)
CRM_MODE=console
CRM_API_URL=
CRM_API_TOKEN=
CRM_WEBHOOK_SECRET=
TANYA_AGENT_ID=
CRM_HUMAN_DEPARTMENT_ID=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tanya_kb_openai
KNOWLEDGE_BACKEND=qdrant