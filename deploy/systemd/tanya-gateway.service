[Unit]
Description=Ms Tanya CRM webhook gateway (FastAPI)
After=network-online.target redis-server.service
Wants=network-online.target
PartOf=tanya.target

[Service]
User=tanya
WorkingDirectory=/opt/ms-tanya
EnvironmentFile=/opt/ms-tanya/.env
ExecStart=/opt/ms-tanya/.venv/bin/python app.py
Restart=always
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=tanya.target
