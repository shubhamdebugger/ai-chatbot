# One turn worker per lane: tanya-turn@0 .. tanya-turn@7 (stream_partitions in config.json; add units if raised)
[Unit]
Description=Ms Tanya turn worker, lane %i
After=network-online.target redis-server.service
Wants=network-online.target
PartOf=tanya.target

[Service]
User=tanya
WorkingDirectory=/opt/ms-tanya
EnvironmentFile=/opt/ms-tanya/.env
ExecStart=/opt/ms-tanya/.venv/bin/python -m tanya.workers turn %i-%i
Restart=always
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=tanya.target
