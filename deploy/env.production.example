# Ms Tanya — production .env (names only; fill on the server, never commit values). Dev and prod are separate files.
RUN_MODE=server
DEV_CONSOLE=0
# AI providers (05-Oct-2026: OpenAI main, Anthropic fallback)
PROVIDER=openai
FALLBACK_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=openai
# per-job reasoning effort for OpenAI GPT-6 models (defaults: understand none, reply none, check low)
OPENAI_REASONING_EFFORT_UNDERSTAND=
OPENAI_REASONING_EFFORT_REPLY=
OPENAI_REASONING_EFFORT_CHECK=
USE_LANGGRAPH=0
# Redis (AOF everysec on the server)
REDIS_URL=redis://127.0.0.1:6379/0
# CRM (Support Board 3.8.4) — HTTPS in production
CRM_MODE=supportboard
CRM_API_URL=https://<crm-host>/include/api.php
CRM_API_TOKEN=            # dedicated API-only ADMIN user (api.php accepts admin tokens only)
CRM_WEBHOOK_SECRET=       # = sb_settings webhooks-key; CRM webhooks-url = https://tanya.example.com/webhook/crm
TANYA_AGENT_ID=           # sb_users id of the bot user (user_type bot)
CRM_HUMAN_DEPARTMENT_ID=
# MySQL for orch_* tables — dedicated login with rights on the orch database only
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
# Knowledge vectors
KNOWLEDGE_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:6333
RECONCILE_EVERY_SECONDS=15
